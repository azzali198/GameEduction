              <xs:element type="xs:string" name="ResponseBEn"/>
              <xs:element type="xs:string" name="ResponseCEn"/>
              <xs:element type="xs:string" name="RightResponseEn"/>
              <xs:element type="xs:string" name="QuestionFr"/>
