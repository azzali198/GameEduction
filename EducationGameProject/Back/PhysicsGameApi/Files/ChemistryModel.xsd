<xs:schema attributeFormDefault="unqualified" elementFormDefault="qualified" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="ChemistryData">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Data">
          <xs:complexType>
            <xs:sequence>
              <xs:element type="xs:short" name="Id"/>
              <xs:element type="xs:string" name="Definition"/>
              <xs:element type="xs:string" name="ChemicalData"/>
              <xs:element type="xs:byte" name="RightResponse"/>
              <xs:element type="xs:string" name="ResponseText"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute type="xs:string" name="branch"/>
    </xs:complexType>
  </xs:element>
</xs:schema>